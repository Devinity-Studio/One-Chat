#!/usr/bin/env bash
# Pre-commit hook: format-check + lint staged HTML files
# One-time activation:  git config core.hooksPath .githooks
#
# Requires network access on first run (npx downloads htmlhint/prettier).
# Note: this hook only checks staged HTML — SQL linting lives in CI (sqlfluff).

set -euo pipefail

# Collect staged .html files (Added/Copied/Modified/Renamed, non-deleted)
FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.html' || true)

if [ -z "$FILES" ]; then
  exit 0
fi

echo "▸ Pre-commit: checking $(echo "$FILES" | wc -l) HTML file(s)..."

FAIL=0

# ---- HTMLHint (correctness) ----
# shellcheck disable=SC2086
if ! npx --yes htmlhint@1 $FILES; then
  echo "✖ htmlhint failed — commit aborted." >&2
  FAIL=1
fi

# ---- Prettier (formatting) ----
if ! npx --yes prettier@3 --check $FILES; then
  echo "✖ Prettier check failed. Run:  npx prettier@3 --write <file>  then re-add." >&2
  FAIL=1
fi

if [ "$FAIL" -ne 0 ]; then
  exit 1
fi

echo "✔ Pre-commit checks passed."
