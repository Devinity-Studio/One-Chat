[sqlfluff]
# Postgres dialect for Supabase
# CI focus: parse errors + a few consistency rules; style/layout rules are
# relaxed because the schema is hand-written (aligns with existing style)
dialect = postgres
templater = jinja
max_line_length = 140
exclude_rules =
    LT01, LT02, LT05, LT12, LT14,
    AL01, AL02, AL03, AL04, AL05, AL06, AL07, AL08,
    AM04, AM05, AM06,
    ST06, ST09,
    RF02, RF03, RF04, RF05, RF06,
    CV06, L029, L031, L034
